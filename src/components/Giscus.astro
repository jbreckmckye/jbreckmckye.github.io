---
// Giscus comments component
// https://giscus.app

interface Props {
  term: string;
}

const { term } = Astro.props;
---

<section class="giscus-container mt-12 pt-8 border-t border-zinc-800">
  <script
    src="https://giscus.app/client.js"
    data-repo="jbreckmckye/jbreckmckye.github.io"
    data-repo-id="MDEwOlJlcG9zaXRvcnkyNjU2MjgwOTg="
    data-category="Q&A"
    data-category-id="DIC_kwDOD9Upws4C5Q46"
    data-mapping="specific"
    data-term={term}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="dark"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>

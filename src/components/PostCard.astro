---
interface Props {
  title: string;
  date?: Date;
  tags?: string[];
  slug: string;
}

const { title, date, tags = [], slug } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

function getPostUrl(date: Date | undefined, slug: string): string {
  if (!date) return `/blog/${slug}`;
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  return `/blog/${year}/${month}/${slug}`;
}
---

<article class="group">
  <a href={getPostUrl(date, slug)} class="block py-6 transition-colors duration-200">
    <h2 class="text-2xl font-semibold text-zinc-100 group-hover:text-blue-400 transition-colors mb-2">
      {title}
    </h2>
    <div class="flex flex-wrap items-center gap-3 text-base text-zinc-500">
      {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="bg-zinc-800 text-zinc-400 px-2 py-0.5 rounded text-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
